// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  ADMIN
  EDITOR
  JOURNALIST
  VIEWER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

// Editorial kind of an article (CONTENT-ARCHITECTURE §1, D-056). Drives templates in the editor and,
// for SPONSORED, the «إعلان» label plus exclusion from news feeds (REVENUE-MAP §3).
enum ArticleKind {
  NEWS
  OPINION
  EXPLAINER
  SPONSORED
  LIVE
  VIDEO
  GALLERY
  CARICATURE
  NOTICE
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

// Models
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String   // bcrypted
  role      UserRole @default(VIEWER)

  // Auth
  emailVerified Boolean @default(false)
  emailVerificationToken String?
  emailVerificationExpires DateTime?

  // Preferences
  preferences Json @default("{}")

  // Public author profile at /author/<slug> (D-067). Shown only for staff with a published article;
  // the email and role never leave the API. slug is set once from the name and kept stable after renames.
  // Unique by code (authors.ts freeSlug/parseProfile), not @unique: adding a unique constraint makes the
  // deploy's plain `prisma db push` stop at a data-loss prompt.
  slug      String?
  jobTitle  String?
  bio       String?
  photoUrl  String?  // an upload on this site (localImage), or null → monogram

  // Relations
  articles  Article[]
  comments  Comment[]
  sessions  Session[]
  savedArticles SavedArticle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@index([slug])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken String @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([refreshToken])
}

model SavedArticle {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  savedAt   DateTime @default(now())

  @@unique([userId, articleId])
  @@index([userId])
}

model Article {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  content           String   // Rich text JSON
  summary           String?
  featuredImageUrl  String?
  coverCredit       String?  // «الصورة: …» — photographer/agency; shown only when set (D-054, F-03)
  coverCaption      String?  // caption under the lead image; falls back to the title
  kind              ArticleKind @default(NEWS) // D-056
  sponsorName       String?  // SPONSORED only: «محتوى مدفوع من ‹الجهة›»

  // Relations
  authorId          String
  author            User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id])

  comments          Comment[]
  savedBy           SavedArticle[]
  liveEntries       LiveEntry[]
  liveEndedAt       DateTime? // LIVE only: coverage closed (D-068); open while null
  // Normalised Arabic search text (D-071): title + summary + body without HTML + keywords, folded by
  // search.ts normalizeAr (no tashkeel/tatweel, one alef, ى→ي, ة→ه, Western digits). Written with a raw
  // UPDATE so it never moves updatedAt (dateModified, BIBLE F-04). A pg_trgm index can come with volume.
  searchText        String?
  
  // Status & Timestamps
  status            ArticleStatus @default(DRAFT)
  publishedAt       DateTime?
  scheduledPublishAt DateTime?
  
  // SEO & Analytics
  seoKeywords       String[] // Array of keywords
  viewsCount        Int      @default(0)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([authorId])
  @@index([categoryId])
  @@index([slug])
  @@index([status])
  @@index([publishedAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  displayOrder Int     @default(0)
  showInNav   Boolean   @default(true) // header/footer navigation (D-043 Stage 3)

  articles    Article[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  status    CommentStatus @default(PENDING)
  
  // Relations
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  
  userId    String?  // Nullable for anonymous comments
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Reader comments (D-043 Stage 4): public name, private email, salted IP hash for moderation
  authorName  String?
  authorEmail String?  // never returned by public endpoints
  ipHash      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
  @@index([status])
}

// Key/value site configuration edited from the dashboard (homepage curation,
// seed flags, …). One row per key, JSON value (D-043 Stage 3).
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Subscription {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("active") // active, unsubscribed
  
  // Preferences
  categories String[] // Array of category IDs user is subscribed to
  
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?
  updatedAt DateTime @updatedAt

  // D-043 Stage 4: one-click unsubscribe link + where the signup came from.
  // Indexed, not @unique: adding a unique constraint to this existing table makes
  // `prisma db push` stop with a data-loss prompt, which fails the deploy. Tokens are
  // 144 random bits, so collisions are not a practical concern.
  unsubToken String?
  // Double opt-in (D-054, S-10): a new or re-subscribing address is `pending` until the
  // confirmation link is used; only `active` rows ever receive mail.
  confirmToken String?
  confirmedAt  DateTime?
  source     String?

  @@index([email])
  @@index([status])
  @@index([unsubToken])
}

// One newsletter send (manual from the dashboard or the automatic morning digest)
model NewsletterIssue {
  id          String    @id @default(cuid())
  subject     String
  intro       String?
  articleIds  String[]
  edition     String?   // null = every active subscriber
  status      String    @default("draft") // draft | sending | sent | failed
  auto        Boolean   @default(false)
  recipients  Int       @default(0)
  sent        Int       @default(0)
  failed      Int       @default(0)
  lastError   String?
  createdById String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime? // when the send loop claimed the issue — lets the scheduler reap a run cut off by a restart (D-054)
  sentAt      DateTime?
  deliveries  NewsletterDelivery[]

  @@index([status])
  @@index([createdAt])
}

// One row per recipient per issue (D-054): a send interrupted by a deploy restart resumes
// from the first address without a `sent` row instead of starting over or staying stuck.
model NewsletterDelivery {
  id             String          @id @default(cuid())
  issueId        String
  issue          NewsletterIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  subscriptionId String
  email          String
  status         String          // sent | failed
  error          String?
  at             DateTime        @default(now())

  @@unique([issueId, subscriptionId])
  @@index([issueId, status])
}

// Reader polls (D-043 Stage 4). slot "home" = the community poll, "debate" = the two-sided debate.
model Poll {
  id        String       @id @default(cuid())
  slot      String       @default("home")
  question  String
  active    Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  options   PollOption[]
  votes     PollVote[]

  @@index([slot, active])
}

model PollOption {
  id     String  @id @default(cuid())
  pollId String
  poll   Poll    @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label  String
  byline String? // debate: who argues this side
  note   String? // debate: the argument
  order  Int     @default(0)
  votes  Int     @default(0)

  @@index([pollId])
}

// One row per (poll, browser) so a reader votes once; voterHash never stores the raw id or IP
model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  voterHash String
  createdAt DateTime @default(now())

  @@unique([pollId, voterHash])
}

// Append-only audit trail (SECURITY S-08/S-16, D-064): who changed content, people, ads and mail, and
// staff sign-ins. No route updates or deletes a row; the scheduler drops entries older than 24 months
// (retention per SECURITY §Audit log). No relation to User, so an entry outlives renames and role changes —
// actorName/actorRole are the values at the time. Addresses are stored only as a salted fingerprint.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String?  // null = the system (scheduler, automatic digest) or nobody (failed sign-in)
  actorName  String?
  actorRole  String?
  action     String   // area.verb, e.g. article.publish, user.role, ads.update, auth.login.fail
  targetType String?
  targetId   String?
  summary    String?  // one Arabic line for the dashboard
  meta       Json?
  ipHash     String?

  @@index([at])
  @@index([action, at])
  @@index([actorId, at])
  @@index([targetType, targetId])
}

// Ad delivery counts (D-057 / ANALYTICS-PLAN §5): one row per day × zone × banner, first-party and
// consent-independent. Views are viewable impressions (≥50% visible for 1 s) reported once per
// banner per page view; clicks are beaconed before the navigation. The media kit and advertiser
// reports read these rows; GA4 is only the second source.
model AdStatDaily {
  id          String   @id @default(cuid())
  day         DateTime @db.Date
  zone        String
  bannerId    String
  impressions Int      @default(0)
  clicks      Int      @default(0)

  @@unique([day, zone, bannerId])
  @@index([bannerId, day])
}

// Live-blog updates of a LIVE article (D-068): plain text, newest first on the page; a key entry
// is listed under «أبرز اللحظات». Deleted with the article.
model LiveEntry {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())
  title     String?
  text      String
  key       Boolean  @default(false)
  authorId  String?
  createdAt DateTime @default(now())

  @@index([articleId, at])
}

// Counted reads per article per Amman calendar day (D-069, ANALYTICS-PLAN §1): the same reads that move
// Article.viewsCount (bots, repeats within 30 min and per-address excess never count), aggregated in
// memory and written once a minute. No relation to Article: the dashboard joins on read and skips
// deleted articles. Counting starts with this table — there is no history before it.
model ArticleViewDaily {
  id        String   @id @default(cuid())
  day       DateTime @db.Date
  articleId String
  views     Int      @default(0)

  @@unique([day, articleId])
  @@index([articleId, day])
}

// Web push for «عاجل» (D-072): one row per browser that opted in. Only what the push service needs —
// no user id, no IP; the endpoint is personal data under PDPL (data map) and is deleted when the push
// service answers 404/410 (subscription gone) or after 5 failures in a row.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  failures  Int      @default(0)
  createdAt DateTime @default(now())
  lastOkAt  DateTime?
}

// One row per alert sent from the dashboard (D-072): what, by whom, and how delivery went.
model PushSend {
  id        String   @id @default(cuid())
  title     String
  url       String
  actorId   String?
  total     Int      @default(0)
  sent      Int      @default(0)
  failed    Int      @default(0)
  removed   Int      @default(0)
  status    String   @default("sending") // sending, done
  createdAt DateTime @default(now())
  doneAt    DateTime?
}
