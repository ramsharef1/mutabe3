// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  ADMIN
  EDITOR
  JOURNALIST
  VIEWER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

// Editorial kind of an article (CONTENT-ARCHITECTURE §1, D-056). Drives templates in the editor and,
// for SPONSORED, the «إعلان» label plus exclusion from news feeds (REVENUE-MAP §3).
enum ArticleKind {
  NEWS
  OPINION
  EXPLAINER
  SPONSORED
  LIVE
  VIDEO
  GALLERY
  CARICATURE
  NOTICE
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

// Models
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String   // bcrypted
  role      UserRole @default(VIEWER)

  // Auth
  emailVerified Boolean @default(false)
  emailVerificationToken String?
  emailVerificationExpires DateTime?

  // Preferences
  preferences Json @default("{}")

  // Relations
  articles  Article[]
  comments  Comment[]
  sessions  Session[]
  savedArticles SavedArticle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken String @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([refreshToken])
}

model SavedArticle {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  savedAt   DateTime @default(now())

  @@unique([userId, articleId])
  @@index([userId])
}

model Article {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  content           String   // Rich text JSON
  summary           String?
  featuredImageUrl  String?
  coverCredit       String?  // «الصورة: …» — photographer/agency; shown only when set (D-054, F-03)
  coverCaption      String?  // caption under the lead image; falls back to the title
  kind              ArticleKind @default(NEWS) // D-056
  sponsorName       String?  // SPONSORED only: «محتوى مدفوع من ‹الجهة›»

  // Relations
  authorId          String
  author            User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id])

  comments          Comment[]
  savedBy           SavedArticle[]
  
  // Status & Timestamps
  status            ArticleStatus @default(DRAFT)
  publishedAt       DateTime?
  scheduledPublishAt DateTime?
  
  // SEO & Analytics
  seoKeywords       String[] // Array of keywords
  viewsCount        Int      @default(0)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([authorId])
  @@index([categoryId])
  @@index([slug])
  @@index([status])
  @@index([publishedAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  displayOrder Int     @default(0)
  showInNav   Boolean   @default(true) // header/footer navigation (D-043 Stage 3)

  articles    Article[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  status    CommentStatus @default(PENDING)
  
  // Relations
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  
  userId    String?  // Nullable for anonymous comments
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Reader comments (D-043 Stage 4): public name, private email, salted IP hash for moderation
  authorName  String?
  authorEmail String?  // never returned by public endpoints
  ipHash      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
  @@index([status])
}

// Key/value site configuration edited from the dashboard (homepage curation,
// seed flags, …). One row per key, JSON value (D-043 Stage 3).
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Subscription {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("active") // active, unsubscribed
  
  // Preferences
  categories String[] // Array of category IDs user is subscribed to
  
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?
  updatedAt DateTime @updatedAt

  // D-043 Stage 4: one-click unsubscribe link + where the signup came from.
  // Indexed, not @unique: adding a unique constraint to this existing table makes
  // `prisma db push` stop with a data-loss prompt, which fails the deploy. Tokens are
  // 144 random bits, so collisions are not a practical concern.
  unsubToken String?
  // Double opt-in (D-054, S-10): a new or re-subscribing address is `pending` until the
  // confirmation link is used; only `active` rows ever receive mail.
  confirmToken String?
  confirmedAt  DateTime?
  source     String?

  @@index([email])
  @@index([status])
  @@index([unsubToken])
}

// One newsletter send (manual from the dashboard or the automatic morning digest)
model NewsletterIssue {
  id          String    @id @default(cuid())
  subject     String
  intro       String?
  articleIds  String[]
  edition     String?   // null = every active subscriber
  status      String    @default("draft") // draft | sending | sent | failed
  auto        Boolean   @default(false)
  recipients  Int       @default(0)
  sent        Int       @default(0)
  failed      Int       @default(0)
  lastError   String?
  createdById String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime? // when the send loop claimed the issue — lets the scheduler reap a run cut off by a restart (D-054)
  sentAt      DateTime?
  deliveries  NewsletterDelivery[]

  @@index([status])
  @@index([createdAt])
}

// One row per recipient per issue (D-054): a send interrupted by a deploy restart resumes
// from the first address without a `sent` row instead of starting over or staying stuck.
model NewsletterDelivery {
  id             String          @id @default(cuid())
  issueId        String
  issue          NewsletterIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  subscriptionId String
  email          String
  status         String          // sent | failed
  error          String?
  at             DateTime        @default(now())

  @@unique([issueId, subscriptionId])
  @@index([issueId, status])
}

// Reader polls (D-043 Stage 4). slot "home" = the community poll, "debate" = the two-sided debate.
model Poll {
  id        String       @id @default(cuid())
  slot      String       @default("home")
  question  String
  active    Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  options   PollOption[]
  votes     PollVote[]

  @@index([slot, active])
}

model PollOption {
  id     String  @id @default(cuid())
  pollId String
  poll   Poll    @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label  String
  byline String? // debate: who argues this side
  note   String? // debate: the argument
  order  Int     @default(0)
  votes  Int     @default(0)

  @@index([pollId])
}

// One row per (poll, browser) so a reader votes once; voterHash never stores the raw id or IP
model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  voterHash String
  createdAt DateTime @default(now())

  @@unique([pollId, voterHash])
}

// Ad delivery counts (D-057 / ANALYTICS-PLAN §5): one row per day × zone × banner, first-party and
// consent-independent. Views are viewable impressions (≥50% visible for 1 s) reported once per
// banner per page view; clicks are beaconed before the navigation. The media kit and advertiser
// reports read these rows; GA4 is only the second source.
model AdStatDaily {
  id          String   @id @default(cuid())
  day         DateTime @db.Date
  zone        String
  bannerId    String
  impressions Int      @default(0)
  clicks      Int      @default(0)

  @@unique([day, zone, bannerId])
  @@index([bannerId, day])
}
