# Backend environment — every variable packages/backend reads.
# Copy to packages/backend/.env.local for local dev (the backend-dev launch
# config sources that file). Never commit a real .env; `.env` is git-ignored.
#
# Production does NOT use this file: the systemd unit loads
# /etc/mutabe3/backend.env. When running the Prisma CLI by hand on the VPS,
# export that file first:
#   set -a; . /etc/mutabe3/backend.env; set +a

# Database (Prisma: prisma/schema.prisma → env("DATABASE_URL"))
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mutabe3

# Server
PORT=8080
NODE_ENV=development

# Public site origin; used to build email verification links
FRONTEND_URL=http://localhost:9100

# Auth — generate each with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Editor image uploads (absolute path outside the git checkout in prod)
UPLOAD_DIR=./uploads

# Email (nodemailer). Leave SMTP_USER empty to send without auth.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mutabe3.news
