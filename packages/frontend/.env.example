# Frontend (Next 14) — copy to .env.local for development; production values live in /etc/mutabe3/frontend.env

# Where server components and the dev /api proxy reach the Express API.
# Local API: http://127.0.0.1:9080 · preview against production data: https://mutabe3.news
VPS_API=http://127.0.0.1:9080

# Google Tag Manager container id (GTM-XXXXXXX). Leave empty to ship no analytics and no consent bar
# (D-055 / ANALYTICS-PLAN). Build-time value: the deploy sources /etc/mutabe3/frontend.env before `next build`.
NEXT_PUBLIC_GTM_ID=
