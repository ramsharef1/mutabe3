{
  "buildCommand": "npm run build --workspace=packages/frontend || echo 'No build needed'",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "http://72.62.132.138:3100/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Forwarded-For",
          "value": "$CLIENT_IP"
        },
        {
          "key": "X-Forwarded-Proto",
          "value": "https"
        }
      ]
    }
  ],
  "env": {
    "VPS_URL": "http://72.62.132.138:3100"
  }
}
