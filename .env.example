# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mutabe3

# Cache (Redis)
REDIS_URL=redis://localhost:6379

# API & Auth
JWT_SECRET=your-jwt-secret-key-change-in-production
API_BASE_URL=http://localhost:3000

# CMS (Strapi)
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your-strapi-api-token

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Environment
NODE_ENV=development
NEXT_PUBLIC_ENV=development

# Logging (local only for MVP)
LOG_LEVEL=debug

# Vercel (for CI/CD only)
# VERCEL_TOKEN is set as GitHub Actions secret

# Post-launch monitoring (Sentry/monitoring service)
# SENTRY_DSN=https://... (add after MVP launch)
